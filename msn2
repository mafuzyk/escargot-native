#!/bin/sh
set -eu

primary_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
profile_root="$primary_data_home/escargot-native-secondary"
export ESCARGOT_NATIVE_ASSETS="${ESCARGOT_NATIVE_ASSETS:-$primary_data_home/escargot-native}"
export XDG_CONFIG_HOME="$profile_root/config"
export XDG_DATA_HOME="$profile_root/data"

exec "$(dirname -- "$0")/escargot-native" "$@"
